{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QEMU gdb z6m_debug",
      "type": "cppdbg",
      "request": "launch",
      // "preLaunchTask": "Run qemu-system",
      "program": "${workspaceFolder}/debug_build/build/z6m_debug",
      "cwd": "${workspaceFolder}/debug_build",
      "MIMode": "gdb",
      "miDebuggerPath": "riscv-none-elf-gdb",
      "miDebuggerArgs": "-q -x ${workspaceFolder}/debug_build/.gdbinit ${workspaceFolder}/debug_build/build/z6m_debug -nx",
      "miDebuggerServerAddress": "localhost:1234",
      "stopAtEntry": true,
      "logging": {
        "engineLogging": true,
        "trace": true,
        "traceResponse": true
      }
    },
    {
      "name": "zilkworm.tests gridmpt",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "Build zilkworm.tests (Debug)",
      "program": "${workspaceFolder}/build-debug/zilkworm.tests",
      "args": ["[gridmpt]", "--break"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Native runner",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "CMake: build",
      "program": "${workspaceFolder}/build/zilk_core/dev/cli/state_transition",
      "args": [
        "$HOME/Documents/code/z6m/temp/blocks/23925902/unifiedBlockAndStateRlp23925902.bin"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb"
    },
    {
      "name": "EEST Debug",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "CMake: build",
      "program": "${workspaceFolder}/build/zilk_core/dev/cli/state_transition",
      "args": [
        "$HOME/Documents/code/z6m/third_party/eest-fixtures/blockchain_tests/paris/eip7610_create_collision/test_init_collision_create_opcode_copy.json"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb"
    }
  ]
}