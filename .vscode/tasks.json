{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build zilkworm.tests (Debug)",
      "type": "shell",
      "command": "cmake -DCMAKE_BUILD_TYPE=Debug -B build-debug -G Ninja -S . && cmake --build build-debug --target zilkworm.tests -j$(nproc)",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run qemu-system",
      "type": "shell",
      "command": "cd debug_build && make qemu",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
         "background": {
          "activeOnStart": true,
          "beginsPattern": ".", 
          "endsPattern": "QEMU waiting for GDB on :1234..."
        }
      }
      ] 
    }
  ]
}