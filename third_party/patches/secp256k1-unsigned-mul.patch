  * implementation for N=30, using 30-bit signed limbs represented as int32_t.
  */
 
+/* Compute the signed 32x32->64 widening multiply using only unsigned multiplication.
+ * This avoids the signed multiply-high instruction (mulh/mulhsu on RISC-V), which is
+ * not available on some ZK prover hardware (e.g. airbender).
+ *
+ * Identity: signed(a*b) = unsigned(a*b) - (a<0 ? b : 0)*2^32 - (b<0 ? a : 0)*2^32
+ * Using arithmetic right shift: a>>31 is 0 when a>=0, -1 (all 1s) when a<0.
+ * So (a>>31) & b == b when a<0, 0 when a>=0. This gives branchless correction.
+ */
+static SECP256K1_INLINE int64_t secp256k1_mul32(int32_t a, int32_t b) {
+    int32_t a_s = a >> 31;
+    int32_t b_s = b >> 31;
+    uint64_t u_prod = (uint64_t)(uint32_t)a * (uint64_t)(uint32_t)b;
+    return (int64_t)u_prod - ((int64_t)(a_s & b) << 32) - ((int64_t)(b_s & a) << 32);
+}
